{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://campusevents-api.onrender.com/:path*"
    },
    {
      "source": "/events/:eventId(\\d+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|facebot|meta-externalagent|twitterbot|telegrambot|linkedinbot|slackbot|discordbot|skypeuripreview|pinterest|redditbot|embedly|applebot|googlebot|bingbot).*"
        }
      ],
      "destination": "https://campusevents-api.onrender.com/public/share/events/:eventId"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
