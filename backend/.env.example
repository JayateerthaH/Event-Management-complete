# Copy to .env (git-ignored) and fill in. Spring Boot loads it at startup (spring.config.import).
# Never commit real values.

# Required — HMAC key for signing JWTs, at least 32 characters (e.g. `openssl rand -hex 32`)
JWT_SECRET=

# Required — referenced by module configs (any random string for local dev)
INTERNAL_SECRET=

# Brevo (email: QR codes, reminders). Without a valid key emails fail and are logged; the app keeps working.
BREVO_API_KEY=
PERSONAL_EMAIL=

# Google sign-in (optional). GOOGLE_CLIENT_ID must equal the frontend's VITE_GOOGLE_CLIENT_ID
# (a Web OAuth client ID ending in .apps.googleusercontent.com). No client secret is needed.
GOOGLE_CLIENT_ID=

# Optional — GitHub OAuth (server-side redirect flow)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI features (optional): set ONE of these keys. Without a key, recommendations and similar events still work,
# AI search falls back to keyword search, and the other AI tools are hidden.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Provider: auto (Claude if its key is set, else Gemini) | claude | gemini | none
# AI_PROVIDER=auto
# Claude model
# AI_MODEL=claude-opus-5-5
# Gemini model: gemini-3.8-flash (default) or gemini-3.5-flash-lite (cheaper)
# GEMINI_MODEL=gemini-3.8-flash

# Event images (optional): Cloudinary keeps them across restarts and resizes them for phones.
# Copy "API environment variable" from the Cloudinary dashboard. Without it, images are saved to disk.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Database (defaults match the local Docker container `postgres_db`)
DB_URL=jdbc:postgresql://localhost:5432/eventdb?currentSchema=public
DB_USERNAME=admin
DB_PASSWORD=admin

# Frontend origin allowed by CORS (comma-separated for several)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Production (see README → Deployment)
# links in emails
# FRONTEND_URL=https://your-frontend.example.com
# with HTTPS
# COOKIE_SECURE=true
# when frontend and API are on different domains
# COOKIE_SAME_SITE=None
# persistent disk for uploads
# APP_IMAGES_FOLDER=/data/uploads/
# persistent disk for certificate templates
# APP_CERTIFICATES_FOLDER=/data/certificates
# SHOW_SQL=false
