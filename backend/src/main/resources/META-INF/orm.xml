<?xml version="1.0" encoding="UTF-8"?>
<!-- Picked up automatically by Spring's default persistence unit. Registers listeners that apply to every entity. -->
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm/orm_3_1.xsd"
                 version="3.1">
    <persistence-unit-metadata>
        <persistence-unit-defaults>
            <entity-listeners>
                <!-- Names the field that is too long instead of failing with a generic database error -->
                <entity-listener class="com.event.sharedmodule.FieldLengthCheck"/>
            </entity-listeners>
        </persistence-unit-defaults>
    </persistence-unit-metadata>
</entity-mappings>
